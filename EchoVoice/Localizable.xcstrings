    "This device can't recognize speech on its own, so Listen stays off. EchoVoice never sends audio to a server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device can't recognize speech on its own, so Listen stays off. EchoVoice never sends audio to a server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede reconocer voz en tu idioma sin conexión. Escuchar permanecerá apagado. EchoVoice nunca envía audio a un servidor."
