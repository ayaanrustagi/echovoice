    "Your readings have shifted over your last few check-ins. A phrase recorded today preserves how you sound today — that recording doesn't change later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your readings have shifted over your last few check-ins. A phrase recorded today preserves how you sound today — that recording doesn't change later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus lecturas han cambiado últimamente. Al grabar una frase hoy, conservas cómo suena tu voz hoy. Esa grabación ya no cambia."
          }
        }
      }
    },
