          }
        }
      }
    },
    "This reading came before you had %@ earlier ones to compare against, so it was saved without being judged. Comparing against fewer readings would mostly react to ordinary variation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reading came before you had %@ earlier ones to compare against, so it was saved without being judged. Comparing against fewer readings would mostly react to ordinary variation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lectura se hizo antes de tener %@ lecturas previas para comparar, así que se guardó sin evaluar cambios. Con menos lecturas, la comparación reflejaría sobre todo variaciones normales."
          }
        }
      }
    },
